{
  "manifest_version": 3,
  "name": "AIntern",
  "version": "1.31.0",
  "description": "Run AIntern workflows on the page you are reading, and fill forms with their results.",
  "key": "",
  "action": {
    "default_title": "AIntern",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "activeTab",
    "debugger",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
